# The API this server talks to.
#   the mock:   http://127.0.0.1:4000   (npm start --prefix examples/mock-api)
#   sandbox:    https://verification-sandbox.didww.com
#   production: https://verification.didww.com
BASE_URL=http://127.0.0.1:4000

PORT=3300

# Every application this server serves, as `key:secret` pairs. The secret is URL-safe base64.
# These are the mock's seeded credentials; a real deployment injects its own.
APPLICATIONS=app_public_callback:gRsKvkdrOL7WBmPnQx69bdaEI-u-VDC_RZLwkRMwG_k,app_public_bare_origin:N_LcOP92KN816zeNCr7QBecO5JR1vuhZ-wAVeTrC5TM

# The application this server signs its own API calls as. Must be one of the keys above.
APPLICATION_KEY=app_public_callback

# Where express mounts the callback route: the path requests arrive on.
CALLBACK_ROUTE=/callbacks/didww

# The path of the REGISTERED callback URL — what the API signs. Defaults to CALLBACK_ROUTE.
# Set it only when the two differ:
#   - a proxy or ingress rewrites the path before your server sees it;
#   - the registered URL is a bare origin (`https://example.com`), whose path is the EMPTY
#     STRING. Then this is `CALLBACK_SIGNED_PATH=` — empty, not `/`.
# CALLBACK_SIGNED_PATH=

# The gate's demo rule: deny any destination starting with this. Empty denies nothing.
# Destinations arrive as digits with no `+`, so this matches `+1 900 555 0100`.
DENY_DESTINATION_PREFIX=1900
