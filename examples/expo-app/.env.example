# Copy to `.env`. Expo inlines only variables prefixed EXPO_PUBLIC_ into the bundle, so nothing
# here is a secret in the shipped sense — see the README on why `basic` must not ship at all.

# Defaults to http://10.0.2.2:4000 on the Android emulator and http://localhost:4000 on the iOS
# simulator, which is where `npm start --prefix examples/mock-api` listens on the host machine.
# EXPO_PUBLIC_BASE_URL=http://10.0.2.2:4000

# `public` or `basic`.
EXPO_PUBLIC_AUTH_MODE=basic

# Seeded by the mock API. `app_basic` is the only seeded application that reaches `pending` with
# nothing but the mock running; the others are listed in the README with the state each produces.
EXPO_PUBLIC_APPLICATION_KEY=app_basic
EXPO_PUBLIC_APPLICATION_SECRET=acBpD4X47M4weWWYOsMgHb4UNJb8knib9LnBkqa8j_g
